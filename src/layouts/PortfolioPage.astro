---
import { BASE, content, paths, type Locale } from "../i18n/content";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = content[locale];
const otherLocale: Locale = locale === "en" ? "es" : "en";

const canonical = `${BASE}${paths[locale]}`;
const accentColor = "oklch(0.82 0.09 145)";

const projects = [
  { name: "CobrandoApp", url: "https://cobrando.app" },
  { name: "Audens Solutions", url: "https://audens.ar" },
  { name: "Taller Cabana", url: "https://tallercabana.com" },
].map((p) => ({
  ...p,
  image: `https://api.microlink.io/?url=${encodeURIComponent(p.url)}&screenshot=true&meta=false&embed=screenshot.url`,
}));

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Rusher",
  alternateName: "rusherdv",
  url: canonical,
  jobTitle: t.role,
  description: t.description,
  email: "mailto:development093@gmail.com",
  knowsLanguage: ["en", "es"],
  sameAs: ["https://github.com/rusherdv", "https://discord.com/users/rusherdv_", "https://t.me/rusherdv"],
  worksFor: {
    "@type": "Organization",
    name: "Audens Solutions",
    url: "https://audens.ar",
  },
};
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.title}</title>
    <meta name="description" content={t.description} />
    <meta name="keywords" content={t.keywords} />
    <meta name="author" content="Rusher" />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />

    <link rel="alternate" hreflang="en" href={`${BASE}${paths.en}`} />
    <link rel="alternate" hreflang="es" href={`${BASE}${paths.es}`} />
    <link rel="alternate" hreflang="x-default" href={`${BASE}${paths.en}`} />

    <meta property="og:title" content={t.title} />
    <meta property="og:description" content={t.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Rusher Portfolio" />
    <meta property="og:image" content={`${BASE}/images/og.webp`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={t.ogLocale} />
    <meta property="og:type" content="website" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={t.title} />
    <meta name="twitter:description" content={t.description} />
    <meta name="twitter:image" content={`${BASE}/images/og.webp`} />

    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link rel="icon" href="/icon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-icon.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="manifest" href="/manifest.json" />

    <link rel="preload" href="/fonts/space-grotesk.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/jetbrains-mono.woff2" as="font" type="font/woff2" crossorigin />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(personSchema)} />

    <style define:vars={{ accentColor }}>
      @font-face {
        font-family: "Space Grotesk";
        font-style: normal;
        font-weight: 400 600;
        font-display: swap;
        src: url("/fonts/space-grotesk.woff2") format("woff2");
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329,
          U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }
      @font-face {
        font-family: "JetBrains Mono";
        font-style: normal;
        font-weight: 400 500;
        font-display: swap;
        src: url("/fonts/jetbrains-mono.woff2") format("woff2");
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329,
          U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }

      * {
        box-sizing: border-box;
      }
      html,
      body {
        margin: 0;
        padding: 0;
        font-family: "Space Grotesk", sans-serif;
      }
      a {
        color: inherit;
        text-decoration: none;
      }

      @keyframes riseIn {
        from {
          opacity: 0;
          transform: translateY(14px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }
      @keyframes pulseDot {
        0%,
        100% {
          opacity: 1;
          transform: scale(1);
        }
        50% {
          opacity: 0.3;
          transform: scale(0.7);
        }
      }
      @keyframes blinkCaret {
        0%,
        49% {
          opacity: 1;
        }
        50%,
        100% {
          opacity: 0;
        }
      }
      .rise {
        opacity: 0;
        animation: riseIn 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) forwards;
      }

      .page {
        min-height: 100vh;
        display: flex;
        align-items: center;
        background: oklch(0.165 0 0);
        padding: clamp(28px, 8vw, 96px);
        position: relative;
      }

      .topbar {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 22px clamp(20px, 5vw, 44px);
        font-family: "JetBrains Mono", monospace;
        font-size: 12px;
        color: rgba(255, 255, 255, 0.4);
        z-index: 3;
      }
      .status {
        display: inline-flex;
        align-items: center;
        gap: 8px;
      }
      .status-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--accentColor);
        animation: pulseDot 2s ease-in-out infinite;
      }
      .topbar-right {
        display: inline-flex;
        align-items: center;
        gap: 16px;
      }
      .lang-switch {
        color: rgba(255, 255, 255, 0.4);
        border-bottom: 1px solid rgba(255, 255, 255, 0.2);
        padding-bottom: 1px;
        transition: color 0.2s ease, border-color 0.2s ease;
      }
      .lang-switch:hover {
        color: rgba(255, 255, 255, 0.85);
        border-color: rgba(255, 255, 255, 0.5);
      }

      main {
        width: 100%;
        max-width: 640px;
        display: flex;
        flex-direction: column;
        position: relative;
        z-index: 2;
      }

      .meta {
        animation-delay: 0.05s;
        display: grid;
        grid-template-columns: 84px 1fr;
        gap: 4px 16px;
        font-family: "JetBrains Mono", monospace;
        font-size: 13px;
        line-height: 1.5;
        margin-bottom: 40px;
      }
      .meta-key {
        color: rgba(255, 255, 255, 0.34);
      }
      .meta-val {
        color: rgba(255, 255, 255, 0.7);
      }

      h1 {
        animation-delay: 0.15s;
        font-weight: 500;
        font-size: clamp(44px, 8vw, 72px);
        line-height: 1;
        margin: 0;
        color: rgba(255, 255, 255, 0.97);
        letter-spacing: -0.03em;
      }
      .caret {
        color: var(--accentColor);
        animation: blinkCaret 1.1s step-end infinite;
        font-weight: 400;
      }

      .tagline {
        animation-delay: 0.28s;
        font-size: clamp(18px, 2.4vw, 24px);
        line-height: 1.45;
        margin: 32px 0 0;
        color: rgba(255, 255, 255, 0.82);
        text-wrap: pretty;
      }
      .tagline strong {
        font-weight: 600;
        color: #fff;
      }

      .cta {
        animation-delay: 0.4s;
        display: inline-flex;
        align-items: center;
        gap: 9px;
        align-self: flex-start;
        margin-top: 26px;
        font-family: "JetBrains Mono", monospace;
        font-size: 14px;
        color: var(--accentColor);
        border-bottom: 1px solid var(--accentColor);
        padding-bottom: 3px;
        transition:
          gap 0.2s ease,
          opacity 0.2s ease;
      }
      .cta:hover {
        gap: 14px;
        opacity: 0.8;
      }

      .divider {
        animation-delay: 0.5s;
        height: 1px;
        background: rgba(255, 255, 255, 0.1);
        margin: 48px 0 22px;
      }

      .projects {
        animation-delay: 0.58s;
      }
      .projects-label {
        display: block;
        font-family: "JetBrains Mono", monospace;
        font-size: 12px;
        letter-spacing: 0.04em;
        color: rgba(255, 255, 255, 0.34);
        margin-bottom: 12px;
      }
      .projects-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 12px;
      }
      .project-card {
        display: block;
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 10px;
        overflow: hidden;
        transition:
          border-color 0.2s ease,
          transform 0.2s ease;
      }
      .project-card:hover {
        border-color: rgba(255, 255, 255, 0.3);
        transform: translateY(-2px);
      }
      .project-thumb {
        display: block;
        width: 100%;
        aspect-ratio: 16 / 10;
        object-fit: cover;
        object-position: top;
        background: rgba(255, 255, 255, 0.04);
      }
      .project-name {
        display: block;
        padding: 8px 10px;
        font-family: "JetBrains Mono", monospace;
        font-size: 12px;
        color: rgba(255, 255, 255, 0.68);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }

      .links {
        animation-delay: 0.68s;
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
      }
      .icon-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 15px;
        border-radius: 9px;
        border: 1px solid rgba(255, 255, 255, 0.1);
        font-family: "JetBrains Mono", monospace;
        font-size: 13px;
        color: rgba(255, 255, 255, 0.68);
        transition:
          border-color 0.2s ease,
          color 0.2s ease;
      }
      .icon-btn:hover {
        border-color: rgba(255, 255, 255, 0.3);
        color: rgba(255, 255, 255, 0.95);
      }

      @media (max-width: 480px) {
        .projects-grid {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </head>
  <body>
    <div class="topbar">
      <span class="status">
        <span class="status-dot"></span>
        {t.available}
      </span>
      <span class="topbar-right">
        <a class="lang-switch" href={t.switchHref} hreflang={otherLocale}>{t.switchLabel}</a>
        <span id="clock" aria-hidden="true"></span>
      </span>
    </div>

    <div class="page">
      <main>
        <div class="meta rise">
          <span class="meta-key">{t.metaRole}</span>
          <span class="meta-val">{t.role}</span>
          <span class="meta-key">{t.metaExp}</span>
          <span class="meta-val">{t.exp}</span>
          <span class="meta-key">{t.metaStudy}</span>
          <span class="meta-val">{t.study}</span>
        </div>

        <h1 class="rise">rusher<span class="caret">_</span></h1>

        <p class="tagline rise">
          {t.taglinePre}<strong>{t.companyName}</strong>{t.taglinePost}
        </p>

        <a class="cta rise" href="https://audens.ar" target="_blank" rel="noopener">
          {t.ctaText}
          <span aria-hidden="true">→</span>
        </a>

        <div class="divider rise"></div>

        <div class="projects rise">
          <span class="projects-label">{t.projectsLabel}</span>
          <div class="projects-grid">
            {
              projects.map((p) => (
                <a class="project-card" href={p.url} target="_blank" rel="noopener" title={p.name}>
                  <img class="project-thumb" src={p.image} alt={p.name} loading="lazy" />
                  <span class="project-name">{p.name}</span>
                </a>
              ))
            }
          </div>
        </div>

        <div class="divider rise"></div>

        <div class="links rise">
          <a
            class="icon-btn"
            href="https://discord.com/users/rusherdv_"
            target="_blank"
            rel="noopener"
            title="Discord: rusherdv_"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
              ><path
                d="M19.54 5.34A16.1 16.1 0 0 0 15.6 4.1l-.2.4a11.9 11.9 0 0 1 3.5 1.8 12.9 12.9 0 0 0-11-.02 12 12 0 0 1 3.5-1.78l-.2-.4a16 16 0 0 0-3.95 1.24A16.7 16.7 0 0 0 1.9 16.9a16.2 16.2 0 0 0 4.9 2.48l.6-1.02a10.6 10.6 0 0 1-1.86-.9l.46-.35a11.5 11.5 0 0 0 9.98 0l.46.35c-.58.35-1.2.65-1.86.9l.6 1.02a16.1 16.1 0 0 0 4.9-2.48 16.6 16.6 0 0 0-2.94-11.55zM8.9 14.3c-.94 0-1.72-.87-1.72-1.94s.76-1.94 1.72-1.94 1.74.88 1.72 1.94c0 1.07-.77 1.94-1.72 1.94zm6.2 0c-.95 0-1.72-.87-1.72-1.94s.76-1.94 1.72-1.94 1.73.88 1.72 1.94c0 1.07-.76 1.94-1.72 1.94z"
              ></path></svg
            >
            <span>{t.discordLabel}</span>
          </a>
          <a
            class="icon-btn"
            href="https://t.me/rusherdv"
            target="_blank"
            rel="noopener"
            title="Telegram: @rusherdv"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
              ><path
                d="M21.94 4.6 18.6 20.3c-.25 1.13-.9 1.4-1.83.87l-5.06-3.73-2.44 2.35c-.27.27-.5.5-1.02.5l.36-5.14 9.35-8.45c.41-.36-.09-.56-.63-.2L6.3 12.9l-5.04-1.58c-1.1-.34-1.12-1.1.23-1.63L20.6 3.35c.91-.34 1.71.22 1.34 1.25z"
              ></path></svg
            >
            <span>{t.telegramLabel}</span>
          </a>
          <a class="icon-btn" href="mailto:development093@gmail.com" title="development093@gmail.com">
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <rect x="3" y="5" width="18" height="14" rx="2"></rect>
              <path d="m3 7 9 6 9-6"></path>
            </svg>
            <span>{t.emailLabel}</span>
          </a>
          <a class="icon-btn" href="https://github.com/rusherdv" target="_blank" rel="noopener" title="GitHub: rusherdv">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
              ><path
                d="M12 2C6.48 2 2 6.58 2 12.25c0 4.53 2.87 8.37 6.85 9.73.5.1.68-.22.68-.49l-.01-1.9c-2.78.62-3.37-1.22-3.37-1.22-.46-1.18-1.11-1.5-1.11-1.5-.9-.64.07-.62.07-.62 1 .07 1.53 1.05 1.53 1.05.89 1.57 2.34 1.12 2.91.86.09-.66.35-1.12.63-1.38-2.22-.26-4.55-1.14-4.55-5.07 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.71 0 0 .84-.28 2.75 1.05a9.3 9.3 0 0 1 5 0c1.91-1.33 2.75-1.05 2.75-1.05.55 1.41.2 2.45.1 2.71.64.72 1.03 1.63 1.03 2.75 0 3.94-2.34 4.8-4.57 5.06.36.32.68.94.68 1.9l-.01 2.82c0 .27.18.6.69.49A10.03 10.03 0 0 0 22 12.25C22 6.58 17.52 2 12 2z"
              ></path></svg
            >
            <span>{t.githubLabel}</span>
          </a>
        </div>
      </main>
    </div>

    <script>
      const clockEl = document.getElementById("clock")!;
      const tick = () => {
        clockEl.textContent = new Date().toLocaleTimeString("en-GB", {
          hour: "2-digit",
          minute: "2-digit",
          second: "2-digit",
        });
      };
      tick();
      setInterval(tick, 1000);
    </script>
  </body>
</html>
